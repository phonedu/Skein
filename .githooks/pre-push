#!/bin/sh
# The publishing gate hook (docs/ryugi/publishing-gate.md). Every pushed
# ref goes through .githooks/gate.mjs: the fork (origin) gets the privacy
# scan, upstream gets the full gate. Install once per clone with:
#   git config core.hooksPath .githooks
# stdin, per pushed ref: "<local_ref> <local_oid> <remote_ref> <remote_oid>"
# (the remote name comes as $1; a zero oid means the ref is being created).

zero=0000000000000000000000000000000000000000
remote="$1"
mode=fork
case "$remote" in
  upstream) mode=upstream ;;
esac

dir=$(dirname "$0")
status=0
while read -r local_ref local_oid remote_ref remote_oid; do
  # A deleted remote ref publishes nothing new.
  [ "$local_oid" = "$zero" ] && continue
  if [ "$remote_oid" = "$zero" ]; then
    node "$dir/gate.mjs" "$mode" --head "$local_oid" --base auto || status=1
  else
    node "$dir/gate.mjs" "$mode" --head "$local_oid" --base "$remote_oid" ||
      status=1
  fi
done
exit "$status"
